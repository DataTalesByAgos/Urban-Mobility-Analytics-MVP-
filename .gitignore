# Project-specific: Data, models, and outputs
# Ignore all files inside these directories but preserve the folders via .gitkeep
data/*
!data/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Geospatial source data (shapefiles, GTFS, etc.) — can be large
comunas/
barrios/
gtfs/
gtfs_processing/

